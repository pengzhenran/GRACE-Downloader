# =============================================================================
#  .gitattributes — GRACE Downloader
# =============================================================================
#  统一行尾：仓库内的文本一律 LF；Windows 脚本检出时必须为 CRLF，
#  否则 cmd 解析 .bat 会错乱（详见 docs/构建与打包.md）。
# =============================================================================

* text=auto eol=lf

# Windows 批处理 / 脚本：检出为 CRLF，与仓库内存储无关
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：不做任何转换
*.exe   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.zip   binary
