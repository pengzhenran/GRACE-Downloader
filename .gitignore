# =============================================================================
#  .gitignore — GRACE Downloader
# =============================================================================
#  本仓库只放源代码、文档与构建脚本。
#  数据、构建产物、以及运行期生成的私密文件一律不入库。
# =============================================================================

# ── 科研数据（体积极大，且版权属于 NASA / 数据生产机构，不入库）─────────────
1_zip/
2_unzipped/
3_grids/
3_processed/
*.nc
*.gfc
*.gz
*.zip

# ── 构建产物 ────────────────────────────────────────────────────────────────
dist/
build/
build_release/
_build_tmp/
*.spec.bak
build_log.txt

# 构建脚本会把这些资源暂存到 src\ 下（源在 docs\）
src/help_docs/
src/地球重力与人类生活TVGG.jpg

# ── 运行期生成：凭据与日志（含 Base64 混淆的密码，绝不入库）──────────────────
.grace_credentials.json
.netrc
.urs_cookies
self_test.log
declaration.txt
help_docs/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 编辑器 / IDE / 系统 ────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
Thumbs.db
desktop.ini
~$*
